{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Usage Checker",
  "version": "0.2.5",
  "identifier": "dev.seo.aiusagechecker",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "AI 사용량",
        "width": 340,
        "height": 560,
        "minWidth": 280,
        "minHeight": 80,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "a_lonely_designer",
    "copyright": "© 2026 a_lonely_designer. All rights reserved.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "languages": [
          "Korean"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "ko-KR"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJEN0UzNDg3Q0ZDNUYwRjYKUldUMjhNWFBoelIrTFpNcHJvVnRDSjNZLzVwN2pqZVpWTXhRYlloRzBMYmFKVXA3VndQd2VNVjcK",
      "endpoints": [
        "https://github.com/stuffit-mono/ai-usage-checker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
